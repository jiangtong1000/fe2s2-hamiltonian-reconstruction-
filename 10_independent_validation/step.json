{
  "step": "10_independent_validation",
  "title": "Direct integrals, embedding and CAS14 FCI",
  "requires": [
    "cas20/rdm2.npy",
    "cas14/rdm2.npy",
    "reference_zhendong/rdm1.npy"
  ],
