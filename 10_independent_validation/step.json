        {
          "script": "10_independent_validation/validate_full.py",
          "cwd": ".",
          "args": [],
          "refine": false
        },
        {
          "script": "10_independent_validation/validate_fci14.py",
          "cwd": ".",
          "args": [],
          "refine": false
        }
      ]
    },
    "smoke": {
      "commands": [
        {
          "script": "10_independent_validation/test_contractions.py",
          "cwd": ".",
          "args": [],
          "refine": false
        },
        {
          "script": "07_ao_cholesky/ao_cholesky.py",
          "cwd": ".",
          "args": [
            "--smoke"
          ],
          "refine": false
        },
        {
          "script": "11_assessment/sector_probability.py",
          "cwd": ".",
          "args": [
            "--smoke"
          ],
          "refine": false
        }
      ],
      "requires": []
